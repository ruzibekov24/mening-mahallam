{
  "rules": {
    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'lastSeenAt'])",
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastSeenAt": {
          ".validate": "newData.val() <= now"
        }
      }
    },
    ".read": false,
    ".write": false
  }
} 